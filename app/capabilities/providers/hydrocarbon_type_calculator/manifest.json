{
  "schema_version": "chemanalyst-mcp-tool.v1",
  "tool_name": "Hydrocarbon Type Calculator",
  "capability_id": "tool.hydrocarbon_type_calculator",
  "description": "Calculate hydrocarbon type composition from saturated/aromatic MS tables and fraction mass percentages.",
  "invocation": {
    "type": "python_script",
    "entrypoint": "examples/tools/hydrocarbon_type/sht0606_official_full.py",
    "adapter_template": "generic_python_function",
    "adapter_config": {
      "script_path": "examples/tools/hydrocarbon_type/sht0606_official_full.py",
      "function_name": "calculate_file",
      "call_style": "input_output_paths",
      "input_field": "input_file",
      "output_artifact_key": "output_excel",
      "output_suffix": ".xlsx",
      "output_filename_template": "{input_stem}_hydrocarbon_type_{run_id}{suffix}",
      "output_parser": {
        "type": "excel_sheet_records",
        "sheet_name": "summary_compare"
      },
      "record_value_mapping_name": "hydrocarbon_type_en",
      "evidence": {
        "schema_version": "hydrocarbon-type.v1",
        "evidence_type": "hydrocarbon_group_composition",
        "method": "hydrocarbon type composition"
      }
    },
    "review_required": true
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "input_file": {
        "type": "string",
        "description": "Excel .xlsx workbook. Required sheets: saturate_ms (m/z, Intensity), aromatic_ms (m/z, Intensity), fractions (saturate_wt_percent, aromatic_wt_percent)."
      },
      "output_dir": {
        "type": "string"
      }
    },
    "required": [
      "input_file"
    ],
    "x_chemanalyst_input_requirements": {
      "file_type": ".xlsx Excel workbook",
      "required_sheets": {
        "saturate_ms": [
          "m/z",
          "Intensity"
        ],
        "aromatic_ms": [
          "m/z",
          "Intensity"
        ],
        "fractions": [
          "saturate_wt_percent",
          "aromatic_wt_percent"
        ]
      },
      "notes": [
        "m/z and Intensity are mass-spectrometric ion/intensity tables for saturated and aromatic fractions.",
        "fractions provides the mass percentages used to combine saturated and aromatic results.",
        "summary_compare is generated by the tool and is not an input sheet."
      ],
      "input_templates": [
        {
          "label": "Example input workbook",
          "field": "input_file",
          "path": "templates/input_template.xlsx",
          "source_path": "examples/tools/hydrocarbon_type/input_template.xlsx",
          "description": "Runnable workbook copied from the reviewed hydrocarbon type calculation tool package."
        }
      ]
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "tool_evidence": {
        "type": "object"
      },
      "artifacts": {
        "type": "object"
      }
    },
    "required": [
      "status",
      "tool_evidence"
    ]
  },
  "evidence_contract": {
    "required_outputs": [
      "tool_evidence",
      "artifacts"
    ],
    "quality_checks": [
      "status_success",
      "structured_result_present",
      "output_excel_present"
    ],
    "artifacts_produced": [
      "hydrocarbon_type_result_excel"
    ]
  },
  "workflow_relations": {
    "upstream_capabilities": [],
    "downstream_capabilities": [],
    "input_bindings": {
      "input_file": "uploaded_artifact.path"
    },
    "output_bindings": {
      "tool_evidence.structured_result": "Evidence Bundle.tool_evidence.hydrocarbon_group_composition",
      "artifacts.output_excel": "Evidence Bundle.tool_evidence.artifacts.output_excel"
    },
    "planner_hint": "Use upstream outputs as candidate inputs and expose this tool's output bindings as downstream evidence."
  },
  "database_integration_contract": {
    "enabled": false,
    "purpose": "Optional. Describe how current-session tool evidence can be aligned with an Experimental DB channel; runtime tool execution does not ingest records automatically."
  },
  "review": {
    "reviewed": true,
    "enabled": true,
    "notes": "Marked reviewed from Analytical Tool Onboarding UI after local adapter/script review."
  },
  "provider_id": "hydrocarbon_type_calculator"
}