PETROLEUM_KB_ENABLED=true
PETROLEUM_KB_DIR=./petroleum_kb

# Unified LLM configuration for the public ChemAnalyst release.
# Use an OpenAI-compatible chat-completions endpoint. Examples:
#   DeepSeek: https://api.deepseek.com
#   OpenAI:   https://api.openai.com/v1
# Fill LLM_MODEL with the exact model name shown by your provider account.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=your_model_name_here
LLM_TIMEOUT_SECONDS=60
LLM_TRUST_ENV=false

# Optional local OCR settings. Leave blank unless OCR is needed.
TESSERACT_CMD=
TESSDATA_PREFIX=

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
